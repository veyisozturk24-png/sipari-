generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String     @id @default(uuid())
  name         String
  email        String     @unique
  passwordHash String?
  status       UserStatus @default(ACTIVE)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  memberships CompanyMember[]

  @@map("users")
}

model Company {
  id        String        @id @default(uuid())
  name      String
  slug      String        @unique
  status    CompanyStatus @default(ACTIVE)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  memberships CompanyMember[]
  channels    ChannelConnection[]
  customers   Customer[]
  products    Product[]
  orders      Order[]
  shipments   Shipment[]

  @@map("companies")
}

model CompanyMember {
  id        String       @id @default(uuid())
  userId    String
  companyId String
  role      MemberRole   @default(ADMIN)
  status    MemberStatus @default(ACTIVE)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([userId, companyId])
  @@index([companyId])
  @@map("company_members")
}

model ChannelConnection {
  id                String          @id @default(uuid())
  companyId         String
  platform          ChannelPlatform
  name              String
  externalAccountId String?
  status            ChannelStatus   @default(DISCONNECTED)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  orders  Order[]

  @@unique([companyId, platform, externalAccountId])
  @@index([companyId])
  @@map("channel_connections")
}

model Customer {
  id        String   @id @default(uuid())
  companyId String
  name      String
  phone     String?
  email     String?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  orders  Order[]

  @@index([companyId])
  @@index([companyId, phone])
  @@index([companyId, email])
  @@map("customers")
}

model Product {
  id          String        @id @default(uuid())
  companyId   String
  name        String
  sku         String
  description String?
  category      String        @default("Genel")
  criticalStock Int           @default(5)
  emoji         String        @default("📦")
  price       Decimal       @db.Decimal(12, 2)
  stock       Int           @default(0)
  status      ProductStatus @default(ACTIVE)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  company    Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  orderItems OrderItem[]

  @@unique([companyId, sku])
  @@index([companyId])
  @@index([companyId, status])
  @@map("products")
}

model Order {
  id                  String      @id @default(uuid())
  companyId           String
  customerId          String?
  channelConnectionId String?
  orderNumber         String
  status              OrderStatus @default(DRAFT)
  currency            String      @default("TRY")
  subtotal            Decimal     @default(0) @db.Decimal(12, 2)
  shippingAmount      Decimal     @default(0) @db.Decimal(12, 2)
  discountAmount      Decimal     @default(0) @db.Decimal(12, 2)
  totalAmount         Decimal     @default(0) @db.Decimal(12, 2)
  customerNote        String?
  internalNote        String?
  shippingName        String?
  shippingPhone       String?
  shippingCity        String?
  shippingDistrict    String?
  shippingAddress     String?
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  company           Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer          Customer?          @relation(fields: [customerId], references: [id], onDelete: SetNull)
  channelConnection ChannelConnection? @relation(fields: [channelConnectionId], references: [id], onDelete: SetNull)
  items             OrderItem[]
  shipment          Shipment?

  @@unique([companyId, orderNumber])
  @@index([companyId])
  @@index([companyId, status])
  @@index([customerId])
  @@index([channelConnectionId])
  @@map("orders")
}

model OrderItem {
  id          String   @id @default(uuid())
  orderId     String
  productId   String?
  productName String
  sku         String?
  quantity    Int
  unitPrice   Decimal  @db.Decimal(12, 2)
  totalPrice  Decimal  @db.Decimal(12, 2)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

model Shipment {
  id             String          @id @default(uuid())
  companyId      String
  orderId        String          @unique
  carrier        ShippingCarrier
  trackingNumber String?
  status         ShipmentStatus  @default(PREPARING)
  shippedAt      DateTime?
  deliveredAt    DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([companyId, status])
  @@index([trackingNumber])
  @@map("shipments")
}

enum UserStatus {
  ACTIVE
  PASSIVE
  BLOCKED
}

enum CompanyStatus {
  ACTIVE
  PASSIVE
}

enum MemberRole {
  OWNER
  ADMIN
  OPERATOR
  WAREHOUSE
  ACCOUNTING
}

enum MemberStatus {
  ACTIVE
  INVITED
  PASSIVE
}

enum ChannelPlatform {
  WHATSAPP
  INSTAGRAM
  FACEBOOK
  WEB
  SHOPIFY
  WOOCOMMERCE
  TRENDYOL
  HEPSIBURADA
  MANUAL
}

enum ChannelStatus {
  CONNECTED
  DISCONNECTED
  ERROR
}

enum ProductStatus {
  ACTIVE
  PASSIVE
  OUT_OF_STOCK
}

enum OrderStatus {
  DRAFT
  PENDING
  CONFIRMED
  PREPARING
  SHIPPED
  DELIVERED
  CANCELLED
  RETURNED
}

enum ShippingCarrier {
  YURTICI
  ARAS
  MNG
  PTT
  SURAT
  HEPSIJET
  KOLAY_GELSIN
  OTHER
}

enum ShipmentStatus {
  PREPARING
  READY
  SHIPPED
  IN_TRANSIT
  OUT_FOR_DELIVERY
  DELIVERED
  FAILED
  RETURNED
  CANCELLED
}
